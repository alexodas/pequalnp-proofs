# Fork-only lease management for a gap obtained by pnp-desk.yml.
# This workflow does not submit a proof and must not be included in upstream PRs.
name: PEqualNP lease control

on:
  workflow_dispatch:
    inputs:
      assignment_run_id:
        description: 'Run ID of the successful PEqualNP desk claim (e.g. 45421029420)'
        required: true
        type: string
      operation:
        description: 'Renew a live lease or release it back to the desk'
        required: true
        type: choice
        default: renew
        options:
          - renew
          - release
      release_reason:
        description: 'Used only when operation is release'
        required: false
        type: choice
        default: out_of_time
        options:
          - out_of_time
          - statement_seems_false
          - hypothesis_too_weak
          - does_not_elaborate
          - missing_lemma
          - other

permissions:
  contents: read
  actions: read

concurrency:
  group: pnp-lease-${{ inputs.assignment_run_id }}
  cancel-in-progress: false

jobs:
  manage:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - name: Validate the claim run ID
        shell: bash
        env:
          ASSIGNMENT_RUN_ID: ${{ inputs.assignment_run_id }}
        run: |
          set -euo pipefail
          if [[ ! "$ASSIGNMENT_RUN_ID" =~ ^[1-9][0-9]{0,17}$ ]]; then
            echo 'Invalid run ID; expected digits only' >&2
            exit 1
          fi

      - name: Download the claim artifact from its original run
        uses: actions/download-artifact@v4
        with:
          run-id: ${{ inputs.assignment_run_id }}
          github-token: ${{ github.token }}
          name: pnp-assignment-${{ inputs.assignment_run_id }}
          path: .pnp-claim

      - name: Renew or release the assigned gap
        shell: bash
        env:
          OPERATION: ${{ inputs.operation }}
          RELEASE_REASON: ${{ inputs.release_reason }}
        run: |
          set -euo pipefail
          python3 - <<'PY'
          import json
          import os
          from pathlib import Path
          import subprocess
          from urllib.parse import urlencode

          data = json.loads(Path('.pnp-claim/assignment.json').read_text(encoding='utf-8'))
          lease = data.get('lease')
          gap = data.get('gap')
          if not isinstance(lease, dict) or not isinstance(lease.get('id'), str) or not lease['id']:
              raise ValueError('Claim artifact has no lease ID')
          if not isinstance(gap, dict) or not isinstance(gap.get('id'), str):
              raise ValueError('Claim artifact has no gap ID')

          operation = os.environ['OPERATION']
          if operation not in ('renew', 'release'):
              raise ValueError('Unexpected operation')

          params = {'lease': lease['id']}
          if operation == 'renew':
              endpoint = 'beat'
          else:
              endpoint = 'release'
              reason = os.environ['RELEASE_REASON']
              if reason not in ('out_of_time', 'statement_seems_false', 'hypothesis_too_weak',
                                'does_not_elaborate', 'missing_lemma', 'other'):
                  raise ValueError('Unexpected release reason')
              params['reason'] = reason

          url = 'https://pequalnp.com/desk/' + endpoint + '?' + urlencode(params)
          response_file = Path(os.environ['RUNNER_TEMP']) / 'pnp-desk-response.json'
          # Match the project's official tools/pnp.sh: curl -X POST with no request body.
          # The opaque lease is passed only as an argument, never echoed or printed.
          call = subprocess.run(
              ['curl', '--silent', '--show-error', '--proto', '=https',
               '--max-redirs', '0', '--max-time', '40', '--max-filesize', '65536',
               '--request', 'POST', '--output', str(response_file),
               '--write-out', '%{http_code}', url],
              capture_output=True, text=True, check=False)
          if call.returncode != 0:
              raise RuntimeError(f'curl could not reach desk (exit {call.returncode})')
          code = call.stdout.strip()
          if code != '200':
              if code == '410':
                  raise RuntimeError('HTTP 410: assignment withdrawn or already settled; stop work and request another')
              if code == '403':
                  raise RuntimeError('HTTP 403: desk rejected the request; check server access/lease status')
              raise RuntimeError(f'Desk returned HTTP {code}')
          print('Gap:', gap['id'])
          if operation == 'release':
              print('Lease released; reason:', params['reason'])
          else:
              result = json.loads(response_file.read_text(encoding='utf-8'))
              next_lease = result.get('lease') if isinstance(result, dict) else None
              if not isinstance(next_lease, dict) or not next_lease.get('expires_at'):
                  raise ValueError('Renewal response lacked an updated expiration')
              print('Lease renewed. New expiration:', next_lease['expires_at'])
          PY
